          .DATA.W     H'3C3A
          .DATA.W     H'4856
          .DATA.W     H'626C
__sftl:
          MOV.L       R2,@-R15
          CMP/PZ      R1
          BF/S        sftl_3
          MOV         #32,R2
          CMP/GE      R2,R1
          BT          sftl_1
          MOV.L       p_quick_mvn_5,R2
          ADD         R1,R2
          MOV.B       @R2,R2
          MOV.L       p_sftl_2,R1
          ADD         R2,R1
          JMP         @R1
          NOP
          .DATA.W     H'0009
          .ALIGN      4
p_sftl_2:
          .DATA.L     sftl_2
p_quick_mvn_5:
          .DATA.L     quick_mvn_5
sftl_1:
          MOV         #0,R0
          RTS
          MOV.L       @R15+,R2
sftl_2:
          .DATA.W     H'4000
          .DATA.W     H'4000
          .DATA.W     H'4000
          .DATA.W     H'4000
          .DATA.W     H'4000
          .DATA.W     H'4000
          .DATA.W     H'4000
sftl_3:
          RTS
          MOV.L       @R15+,R2
          .DATA.W     H'4000
          .DATA.W     H'4000
