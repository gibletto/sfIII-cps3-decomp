; tasksw.src  Task switcher
;
; The cooperative task kernel. _task_dispatch saves the scheduler's registers and switches to the
; current task's stack, GBR, SR and resume address. _task_sleep (R4 frames), _task_wait and
; _task_yield save the running task's registers, set its state in the task record and return to the
; scheduler through _task_exit_to_system, which reloads the scheduler's stack, SR and GBR and pops
; its registers (destroy_current_task also leaves a task this way). _main_thunk loads the stack
; pointer from the vector table and jumps to Game_Task, the scheduler loop. _vector_restart and
; _bios_vector_restart restart execution from a given vector table with all registers cleared.
; The program start, reset_entry, is in reset.c.

          .CPU        SH2
          .INCLUDE    "include\cps3.inc"
          .IMPORT     _Game_Task
          .EXPORT     _bios_vector_restart
          .EXPORT     _vector_restart
          .EXPORT     _main_thunk
          .EXPORT     _task_dispatch
          .EXPORT     _task_exit_to_system
          .EXPORT     _task_sleep
          .EXPORT     _task_wait
          .EXPORT     _task_yield
          .IMPORT     _task_sched_context
          .IMPORT     _current_task
          .SECTION    P,CODE,ALIGN=4
_main_thunk:
          STC         VBR,R10
          ADD         #4,R10
          MOV.L       @R10,R15
          MOV.L       p_Game_Task,R10
          JMP         @R10
          NOP
          .ALIGN      4
p_Game_Task:
          .DATA.L     _Game_Task
_task_dispatch:
          MOV.L       R0,@-R15
          MOV.L       R1,@-R15
          MOV.L       R2,@-R15
          MOV.L       R3,@-R15
          MOV.L       R4,@-R15
          MOV.L       R5,@-R15
          MOV.L       R6,@-R15
          MOV.L       R7,@-R15
          MOV.L       R8,@-R15
          MOV.L       R9,@-R15
          MOV.L       R10,@-R15
          MOV.L       R11,@-R15
          MOV.L       R12,@-R15
          MOV.L       R13,@-R15
          MOV.L       R14,@-R15
          STS.L       PR,@-R15
          MOV.L       p_task_sched_context,R0
          MOV.L       R15,@R0
          ADD         #4,R0
          STC         SR,R1
          MOV.L       R1,@R0
          ADD         #4,R0
          STC         GBR,R1
          MOV.L       R1,@R0
          MOV.L       p_current_task,R0
          MOV.L       @R0,R14
          MOV.L       @(16,R14),R0
          MOV         R0,R15
          MOV.L       @(28,R14),R0
          LDC         R0,GBR
          MOV.L       @(8,R14),R1
          MOV.L       @(24,R14),R0
          JMP         @R1
          LDC         R0,SR
          .ALIGN      4
p_task_sched_context:
          .DATA.L     _task_sched_context
p_current_task:
          .DATA.L     _current_task
_task_sleep:
          MOV.L       R0,@-R15
          MOV.L       R1,@-R15
          MOV.L       R2,@-R15
          MOV.L       R3,@-R15
          MOV.L       R4,@-R15
          MOV.L       R5,@-R15
          MOV.L       R6,@-R15
          MOV.L       R7,@-R15
          MOV.L       R8,@-R15
          MOV.L       R9,@-R15
          MOV.L       R10,@-R15
          MOV.L       R11,@-R15
          MOV.L       R12,@-R15
          MOV.L       R13,@-R15
          MOV.L       R14,@-R15
          MOV         #-16,R0
          STC         SR,R1
          LDC         R0,SR
          STS.L       PR,@-R15
          MOV.L       p_current_task_2,R0
          MOV.L       @R0,R14
          MOV         #1,R0
          TST         R4,R4
          BF          task_sleep_set
          MOV         #5,R0
task_sleep_set:
          MOV.B       R0,@(0,R14)
          MOV         R4,R0
          MOV.B       R0,@(1,R14)
          BSR         task_yield_save
          NOP
          LDS.L       @R15+,PR
          MOV.L       @R15+,R14
          MOV.L       @R15+,R13
          MOV.L       @R15+,R12
          MOV.L       @R15+,R11
          MOV.L       @R15+,R10
          MOV.L       @R15+,R9
          MOV.L       @R15+,R8
          MOV.L       @R15+,R7
          MOV.L       @R15+,R6
          MOV.L       @R15+,R5
          MOV.L       @R15+,R4
          MOV.L       @R15+,R3
          MOV.L       @R15+,R2
          MOV.L       @R15+,R1
          MOV.L       @R15+,R0
          RTS
          NOP
          .ALIGN      4
p_current_task_2:
          .DATA.L     _current_task
_task_wait:
          MOV.L       R0,@-R15
          MOV.L       R1,@-R15
          MOV.L       R2,@-R15
          MOV.L       R3,@-R15
          MOV.L       R4,@-R15
          MOV.L       R5,@-R15
          MOV.L       R6,@-R15
          MOV.L       R7,@-R15
          MOV.L       R8,@-R15
          MOV.L       R9,@-R15
          MOV.L       R10,@-R15
          MOV.L       R11,@-R15
          MOV.L       R12,@-R15
          MOV.L       R13,@-R15
          MOV.L       R14,@-R15
          MOV         #-16,R0
          STC         SR,R1
          LDC         R0,SR
          STS.L       PR,@-R15
          MOV.L       p_current_task_3,R0
          MOV.L       @R0,R14
          MOV.L       k_0,R0
          MOV.L       R0,@(40,R14)
          MOV         #2,R0
          MOV.B       R0,@(0,R14)
          BSR         task_yield_save
          NOP
          LDS.L       @R15+,PR
          MOV.L       @R15+,R14
          MOV.L       @R15+,R13
          MOV.L       @R15+,R12
          MOV.L       @R15+,R11
          MOV.L       @R15+,R10
          MOV.L       @R15+,R9
          MOV.L       @R15+,R8
          MOV.L       @R15+,R7
          MOV.L       @R15+,R6
          MOV.L       @R15+,R5
          MOV.L       @R15+,R4
          MOV.L       @R15+,R3
          MOV.L       @R15+,R2
          MOV.L       @R15+,R1
          MOV.L       @R15+,R0
          RTS
          NOP
          .DATA.W     H'0000
          .ALIGN      4
p_current_task_3:
          .DATA.L     _current_task
k_0:
          .DATA.L     H'00000000
_task_yield:
task_yield_save:
          MOV         R15,R0
          MOV.L       R0,@(16,R14)
          STS         PR,R0
          MOV.L       R0,@(8,R14)
          MOV         R1,R0
          MOV.L       R0,@(24,R14)
          STC         GBR,R0
          MOV.L       R0,@(28,R14)
_task_exit_to_system:
          MOV.L       p_task_sched_context_2,R0
          MOV.L       @R0+,R15
          LDC.L       @R0+,SR
          LDC.L       @R0+,GBR
          LDS.L       @R15+,PR
          MOV.L       @R15+,R14
          MOV.L       @R15+,R13
          MOV.L       @R15+,R12
          MOV.L       @R15+,R11
          MOV.L       @R15+,R10
          MOV.L       @R15+,R9
          MOV.L       @R15+,R8
          MOV.L       @R15+,R7
          MOV.L       @R15+,R6
          MOV.L       @R15+,R5
          MOV.L       @R15+,R4
          MOV.L       @R15+,R3
          MOV.L       @R15+,R2
          MOV.L       @R15+,R1
          MOV.L       @R15+,R0
          RTS
          NOP
          .ALIGN      4
p_task_sched_context_2:
          .DATA.L     _task_sched_context
_vector_restart:
          MOV.L       k_F0,R1
          LDC         R1,SR
          MOV         R4,R1
          LDC         R1,VBR
          MOV.L       @R1,R0
          LDS         R0,PR
          MOV.L       @(4,R1),R15
          MOV         #0,R0
          MOV         #0,R1
          MOV         #0,R2
          MOV         #0,R3
          MOV         #0,R4
          MOV         #0,R5
          MOV         #0,R6
          MOV         #0,R7
          MOV         #0,R8
          MOV         #0,R9
          MOV         #0,R10
          MOV         #0,R11
          MOV         #0,R12
          MOV         #0,R13
          MOV         #0,R14
          LDS         R0,MACH
          LDS         R0,MACL
          RTS
          NOP
          .ALIGN      4
k_F0:
          .DATA.L     H'000000F0
_bios_vector_restart:
          MOV.L       k_F0_2,R1
          LDC         R1,SR
          LDC         R5,VBR
          MOV.L       @R4,R0
          LDS         R0,PR
          MOV.L       @(4,R4),R15
          MOV         #0,R0
          MOV         #0,R1
          MOV         #0,R2
          MOV         #0,R3
          MOV         #0,R4
          MOV         #0,R5
          MOV         #0,R6
          MOV         #0,R7
          MOV         #0,R8
          MOV         #0,R9
          MOV         #0,R10
          MOV         #0,R11
          MOV         #0,R12
          MOV         #0,R13
          MOV         #0,R14
          LDS         R0,MACH
          LDS         R0,MACL
          RTS
          NOP
          .DATA.W     H'0000
          .ALIGN      4
k_F0_2:
          .DATA.L     H'000000F0
          .END
