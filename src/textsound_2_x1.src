; textsound_2_x1.src  Sound driver interface: start-up, sequence requests, music control
;
; _sound_init resets the sound chip (the 21 set-up words of sound_init_data to its control port, every voice
; register cleared, the control word with the stereo flag and volume) and the driver: the sequence data and its
; count, the envelope and LFO rate tables, the sample and bank tables, the master volumes, and every music and
; effect voice stopped (status C0). _sound_request starts a sound code. _sound_seq_start finds the code's
; sequence: a music sequence (first byte 0) stops the music and starts a music voice per track; an effect
; sequence starts each track on the effect voice of the same number when that voice is stopped or plays an effect
; of no higher priority; a first byte with bit 7 set sets up the one effect voice its low four bits name.
; _sound_request_pan starts a code with a pan ramp (start, end, time). _bgm_stop stops the music voices;
; _bgm_pause saves their states and key-on bits and stops them, _bgm_resume puts them back. _sound_fade_in_submit
; starts a code with the master level fading in; _bgm_fade_out fades the music out. _sound_reg_level_set sets
; a pitch offset and a level offset for the music voices.
; The C these routines were compiled from is in nonmatching/textsound_2.c.

          .CPU        SH2
          .INCLUDE    "include\cps3.inc"
          .IMPORT     __divls
          .IMPORT     __quick_mvn
          .IMPORT     __slow_mvn
          .IMPORT     _bgm_master_vol
          .IMPORT     _bgm_master_vol_init
          .IMPORT     _bgm_status_save
          .IMPORT     _bgm_tick_step
          .IMPORT     _bgm_voice
          .IMPORT     _midi_vlq_decode_while
          .IMPORT     _se_pan_ramp
          .IMPORT     _se_ramp_req
          .IMPORT     _se_tick_step
          .IMPORT     _se_voice
          .IMPORT     _snd_attack_ptr
          .IMPORT     _snd_attack_rate_tbl
          .IMPORT     _snd_bank_tbl
          .IMPORT     _snd_ctrl
          .IMPORT     _snd_decay_ptr
          .IMPORT     _snd_decay_rate_tbl
          .IMPORT     _snd_fade_level
          .IMPORT     _snd_fade_speed
          .IMPORT     _snd_lfo_rate_ptr
          .IMPORT     _snd_lfo_rate_tbl
          .IMPORT     _snd_master_vol
          .IMPORT     _snd_pitch_lfo_ptr
          .IMPORT     _snd_pitch_lfo_tbl
          .IMPORT     _snd_reg_save
          .IMPORT     _snd_sample_tbl
          .IMPORT     _snd_seq_data
          .IMPORT     _snd_seq_max
          .IMPORT     _snd_stereo
          .IMPORT     _snd_vol_lfo_ptr
          .IMPORT     _snd_vol_lfo_tbl
          .IMPORT     _sound_init_data
          .IMPORT     _sound_sample_submit_work4
          .IMPORT     _sound_sample_submit_work7
          .IMPORT     _voice_state_init_pair_work
          .EXPORT     _sound_init
          .EXPORT     _sound_request
          .EXPORT     _sound_seq_start
          .EXPORT     _sound_request_pan
          .EXPORT     _bgm_stop
          .EXPORT     _bgm_pause
          .EXPORT     _bgm_resume
          .EXPORT     _sound_fade_in_submit
          .EXPORT     _bgm_fade_out
          .EXPORT     _sound_reg_level_set
          .SECTION    PSYS,CODE,ALIGN=4
_sound_init:
          MOV.L       R14,@-R15
          MOV.L       R13,@-R15
          MOV.L       R12,@-R15
          MOV.L       R11,@-R15
