          MOV.L       R8,@-R15
          STS.L       PR,@-R15
          ADD         #-44,R15
          MOV.L       p_ext_sw_202,R8
          MOV         R15,R10
          MOV.W       k_100,R11
          MOV.L       p_snd_seq_max,R12
          MOV         #0,R13
          MOV.W       k_c0,R14
          MOV         R15,R1
          MOV.L       p_sound_init_data,R2
          MOV.L       o_slow_mvn,R3
          BSRF        R3
          MOV         #42,R0
