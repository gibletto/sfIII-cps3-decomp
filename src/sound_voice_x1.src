; sound_voice_x1.src  Sound voice sequencer
;
; _voice_process_primary steps a voice's sequence: unless the voice waits or has ended, it reads events up to the
; next delay: notes (the patch for the key from the instrument bank, the pitch, the envelope rates, the length or
; a tie), tempo, bank and program changes, pitch bend, fine tune, LFO depths and rate, volume, pan, expression,
; portamento, transposition, level offsets, priority, repeats, jumps and loops. The end event stops the voice and
; lets the music voice under an effect voice sound again.
; It follows sound_envelope_rate and voice_process_null (sound_voice.c) in the same code run, so its section
; starts at a halfword boundary: its section is ALIGN=2, its PC-relative loads give their displacements as
; expressions, and its literals are HWORD/LWORD halfword pairs. The C it was compiled from is in
; nonmatching/sound_voice.c.

          .CPU        SH2
          .INCLUDE    "include\cps3.inc"
          .IMPORT     _bgm_tick_step
          .IMPORT     _bgm_voice
          .IMPORT     _midi_vlq_decode_leading
          .IMPORT     _midi_vlq_decode_while
          .IMPORT     _se_pan_ramp
          .IMPORT     _se_tick_step
          .IMPORT     _snd_attack_ptr
          .IMPORT     _snd_bank_tbl
          .IMPORT     _snd_decay_ptr
          .IMPORT     _snd_lfo_rate_ptr
          .IMPORT     _snd_pitch_lfo_ptr
          .IMPORT     _snd_sample_tbl
          .IMPORT     _snd_vol_lfo_ptr
          .IMPORT     _sound_envelope_rate
          .EXPORT     _voice_process_primary
          .SECTION    PSYS,CODE,ALIGN=2
