; sound_voice_2.src  Sound voice output
;
; _sound_note_to_pitch turns a pitch in 1/256 semitones into the chip's pitch word: snd_pitch_tbl holds one
; octave, shifted by the octave. _sound_voice_volume_compute scales an envelope level by the voice's volume,
; expression and level offsets and the master volumes (the music also by the fade), with the chip's output curve
; in mono. _voice_process_secondary counts the voice's delays down, keys notes on (the sample's addresses into the
; voice's chip registers) and off, runs the portamento, the envelope (attack, decay, sustain, release), the LFOs
; and the effect pan ramps, and writes the voice's left and right levels and pitch to the chip.
; _sound_reg_write_verify writes a chip register until it reads back the value.
; The C these routines were compiled from is in nonmatching/sound_voice_2.c.

          .CPU        SH2
          .INCLUDE    "include\cps3.inc"
          .IMPORT     __quick_mvn
          .IMPORT     __sftl
          .IMPORT     _bgm_master_vol
          .IMPORT     _bgm_tick_step
          .IMPORT     _se_pan_ramp
          .IMPORT     _se_tick_step
          .IMPORT     _se_voice
          .IMPORT     _snd_ctrl
          .IMPORT     _snd_decay_ptr
          .IMPORT     _snd_fade_level
          .IMPORT     _snd_master_vol
          .IMPORT     _snd_pitch_tbl
          .IMPORT     _snd_stereo
          .IMPORT     _snd_wave_bias
          .IMPORT     _sound_envelope_rate
          .IMPORT     _bgm_volume_offset
          .IMPORT     _bgm_pitch_offset
          .EXPORT     _sound_note_to_pitch
          .EXPORT     _sound_voice_volume_compute
          .EXPORT     _voice_process_secondary
          .EXPORT     _sound_reg_write_verify
          .SECTION    PSYS,CODE,ALIGN=4
_sound_note_to_pitch:
          MOV.W       k_c00,R6
          CMP/GE      R6,R4
          BF/S        sound_note_to_pitch_010
          MOV         #0,R5
sound_note_to_pitch_008:
          SUB         R6,R4
          CMP/GE      R6,R4
          BT/S        sound_note_to_pitch_008
          ADD         #1,R5
sound_note_to_pitch_010:
          CMP/PZ      R4
          BT          sound_note_to_pitch_01C
sound_note_to_pitch_014:
          ADD         R6,R4
          CMP/PZ      R4
          BF/S        sound_note_to_pitch_014
          ADD         #-1,R5
sound_note_to_pitch_01C:
          SHLL        R4
          EXTS.B      R5,R2
          MOV.L       p_snd_pitch_tbl,R3
          ADD         R3,R4
          MOV.W       @R4,R4
          CMP/PL      R2
          BF/S        sound_note_to_pitch_036
          ADD         #1,R4
sound_note_to_pitch_02C:
          SHLL        R4
          ADD         #-1,R5
          EXTS.B      R5,R2
          CMP/PL      R2
          BT          sound_note_to_pitch_02C
sound_note_to_pitch_036:
          EXTS.B      R5,R2
          CMP/PZ      R2
          BT          sound_note_to_pitch_048
sound_note_to_pitch_03C:
          EXTU.W      R4,R4
          ADD         #1,R5
          SHLR        R4
          EXTS.B      R5,R2
          CMP/PZ      R2
          BF          sound_note_to_pitch_03C
sound_note_to_pitch_048:
          ADD         #-1,R4
          RTS
          MOV         R4,R0

